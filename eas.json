{
  "cli": {
    "version": ">= 16.26.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://aptcare.click",
        "EXPO_PUBLIC_API_CHAT_HUB_URL": "https://aptcare.click/chatHub"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
